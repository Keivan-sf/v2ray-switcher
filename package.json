        "install:xray": "npx ts-node scripts/install-xray.ts --outdir=./src",
        "install:v2parser": "npx ts-node scripts/install-v2parser.ts --outdir=./src",
        "release": "npx ts-node scripts/release.ts",
        "test": "npx jest"
    },
